<Window
    x:Class="WpfPrismFrameworkTemplate.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:ctrlz="clr-namespace:ControlzEx.Behaviors;assembly=ControlzEx"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:viewmodels="clr-namespace:WpfPrismFrameworkTemplate.ViewModels"
    xmlns:cv="clr-namespace:WpfPrismFrameworkTemplate.Converter"
    Title="{Binding Title}"
    Width="825"
    Height="450"
    prism:ViewModelLocator.AutoWireViewModel="True">
    <Window.Resources>
        <cv:PersonToStringConverter x:Key="PersonToStringConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" VerticalAlignment="Center" Background="DarkRed">
            <Button Content="打开文件" Command="{Binding OpenFileCmd}" Margin="5" FontWeight="Heavy"/>
            <hc:SearchBar Command="{Binding SearchCmd}" CommandParameter="{Binding Text,RelativeSource={RelativeSource Self}}" Width="200" Foreground="White"
                          Style="{StaticResource SearchBarExtend.Small}"  hc:InfoElement.TitlePlacement="Left" hc:InfoElement.Title="搜索字段"/>
        </WrapPanel>
        <!--<RichTextBox Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                     HorizontalScrollBarVisibility="Auto">
            <FlowDocument>
                <Paragraph>
                    <Run Text="{Binding HighlightedContent}" />
                </Paragraph>
            </FlowDocument>
        </RichTextBox>-->
        <UniformGrid Rows="1" Columns="2" Grid.Row="1">

            <ListBox ItemsSource="{Binding PeopleList}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SelectedItem="{Binding SelectPeople}">
                <!-- ItemTemplate 用来定义每个列表项的显示方式 -->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding IdName}" FontSize="16" FontWeight="Bold" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TabControl Foreground="Black" >
                <hc:TabItem Header="属性设置"  Foreground="Black" FontWeight="Heavy">
                    <hc:ScrollViewer >
                        <StackPanel>
                            <hc:PropertyGrid SelectedObject="{Binding SelectPeople}" />
                            <UniformGrid Rows="1" Columns="2">
                                <TextBox Grid.Row="0"
                                         Text="{Binding SelectPeople.BirthDay}"
     Grid.Column="1"
     Margin="4" 
     Style="{StaticResource TextBoxExtend}"  
     hc:TitleElement.Title="出生年月"
     hc:TitleElement.TitlePlacement="Top">
                                    <i:Interaction.Behaviors>
                                        <ctrlz:TextBoxInputMaskBehavior InputMask="0000年00月00日" />
                                    </i:Interaction.Behaviors>
                                </TextBox>
                                <TextBox Grid.Row="0"
                                         Text="{Binding SelectPeople.DeathDay}"
     Grid.Column="1"
     Margin="4" 
     Style="{StaticResource TextBoxExtend}"  
     hc:TitleElement.Title="离世年月"
     hc:TitleElement.TitlePlacement="Top">
                                    <i:Interaction.Behaviors>
                                        <ctrlz:TextBoxInputMaskBehavior InputMask="0000年00月00日" />
                                    </i:Interaction.Behaviors>
                                </TextBox>
                            </UniformGrid>
                            
                        </StackPanel>
                                           
                    </hc:ScrollViewer>
                    
                </hc:TabItem>
                <hc:TabItem Header="内容显示"  Foreground="Black" FontWeight="Heavy">
                    <TextBox Margin="5" Text="{Binding SelectPeople, Converter={StaticResource PersonToStringConverter}}" />
                </hc:TabItem>
            </TabControl>
        </UniformGrid>
        <WrapPanel Grid.Row="2" Background="DarkRed">
            <Button Content="生成" Margin="5" FontWeight="Heavy" Command="{Binding CreatePeopleCmd}"/>
        </WrapPanel>
    </Grid>
</Window>
