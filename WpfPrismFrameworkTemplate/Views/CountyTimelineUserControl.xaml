<UserControl x:Class="WpfPrismFrameworkTemplate.Views.CountyTimelineUserControl"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:ctrlz="clr-namespace:ControlzEx.Behaviors;assembly=ControlzEx"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:viewmodels="clr-namespace:WpfPrismFrameworkTemplate.ViewModels"
    xmlns:cv="clr-namespace:WpfPrismFrameworkTemplate.Converter"
    xmlns:model="clr-namespace:WpfPrismFrameworkTemplate.Model" 
    xmlns:helper="clr-namespace:WpfPrismFrameworkTemplate.Helper"
    xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    xmlns:ui="http://schemas.modernwpf.com/2019"
xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"          
             prism:ViewModelLocator.AutoWireViewModel="True" >
    <UserControl.Resources>

        <Style x:Key="TimelineRectStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="30" />
            <Setter Property="Stroke" Value="Black" />
            <Setter Property="StrokeThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="3" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Unloaded">
            <i:InvokeCommandAction Command="{Binding SaveCmd}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid Background="White">
        <Grid.RowDefinitions>
            
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>
        <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Background="DarkRed">
            <Button Style="{StaticResource ButtonWarning}" Background="#0000" BorderThickness="0" Foreground="Black"
hc:BorderElement.CornerRadius="15"  Command="{Binding SaveCmd}"
>
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/savefile.png" />
                    </StackPanel>
                </Button.Content>
            </Button>
        </WrapPanel>
        <StackPanel Grid.Row="0" Grid.Column="0">
            <StackPanel >
                <ui:AutoSuggestBox x:Name="CountyAutoSuggestBox"
            PlaceholderText="搜索领地..." VerticalAlignment="Center" Margin="5"
            Text="{Binding SelectCounty, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
            ItemsSource="{Binding Suggestions}"
                                    TextChanged="AutoSuggestBox_TextChanged"
    QuerySubmitted="AutoSuggestBox_QuerySubmitted"
    SuggestionChosen="AutoSuggestBox_SuggestionChosen">

                    <!-- 自定义项目模板 -->
                    <ui:AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Column="0" Grid.Row="0"
Text="{Binding Name}" 
FontWeight="Bold" />
                                   
                                </Grid>
                                <Border Grid.Row="1" 
                    BorderThickness="0,0,0,1" 
                    BorderBrush="#20000000" 
                    Margin="0" />
                            </Grid>


                        </DataTemplate>
                    </ui:AutoSuggestBox.ItemTemplate>
                </ui:AutoSuggestBox>
            </StackPanel>
            <ListView Grid.Row="0" Grid.Column="0" ItemsSource="{Binding Counties}" SelectedItem="{Binding SelectCounty}"
          >
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="Black"
                       Style="{StaticResource TextBlockDefaultInfo}"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
           
        <ListView Grid.Column="1" ItemsSource="{Binding SelectCounty.HolderEntries}" BorderThickness="0"
                  Style="{StaticResource ListView.Small}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="开始时间" DisplayMemberBinding="{Binding StartDate}" Width="100"/>
                    <GridViewColumn Header="持有者" DisplayMemberBinding="{Binding Holder}" Width="140"/>
                </GridView>
            </ListView.View>
        </ListView>
        <ScrollViewer Grid.Column="2" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="5"
                      Style="{StaticResource ScrollViewerNativeBaseStyle}">
            <ItemsControl ItemsSource="{Binding TimelineEntries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 日期范围 -->
                            <TextBlock Grid.Column="0" Text="{Binding StartDate}" 
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>

                            <!-- 连接线和圆点 -->
                            <Grid Grid.Column="1">
                                <Line X1="15" Y1="0" X2="15" Y2="40" Stroke="Gray" StrokeThickness="2"/>
                                <Ellipse Width="14" Height="14" Fill="{Binding Background}" Stroke="Black" 
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <Button Grid.Column="2" hc:IconElement.Geometry="{StaticResource AddGeometry}" hc:IconElement.Height="10" hc:IconElement.Width="10" Background="Green" Foreground="White" Style="{StaticResource ButtonIconCircular.Small}"
        Command="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}, Path=DataContext.AddCmd}"
                                    CommandParameter="{Binding}"/>
                            <Button Grid.Column="3" hc:IconElement.Geometry="{StaticResource SubGeometry}" hc:IconElement.Height="10" hc:IconElement.Width="10" Background="Red" Foreground="White" Style="{StaticResource ButtonIconCircular.Small}"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}, Path=DataContext.DelCmd}"
                                    CommandParameter="{Binding}"/>
                            <!-- 持有者信息 -->
                            <Border Grid.Column="4" Background="{Binding Background}" CornerRadius="5" 
                                    Padding="10,5" MinHeight="30">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{Binding Holder}" FontWeight="Bold"/>
                                    <WrapPanel Grid.Row="1">
                                        <TextBlock  Text="{Binding StartDate, StringFormat='从 {0}'}"/>
                                        <TextBlock  Text="{Binding EndDate, StringFormat='到 {0}'}"/>
                                    </WrapPanel>
                                    
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
