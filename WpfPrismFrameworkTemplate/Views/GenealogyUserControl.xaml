<UserControl x:Class="WpfPrismFrameworkTemplate.Views.GenealogyUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:ctrlz="clr-namespace:ControlzEx.Behaviors;assembly=ControlzEx"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:viewmodels="clr-namespace:WpfPrismFrameworkTemplate.ViewModels"
    xmlns:cv="clr-namespace:WpfPrismFrameworkTemplate.Converter"
    xmlns:model="clr-namespace:WpfPrismFrameworkTemplate.Model" 
    xmlns:helper="clr-namespace:WpfPrismFrameworkTemplate.Helper"
    xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:localui="clr-namespace:WpfPrismFrameworkTemplate.Views"
xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"          
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <DataTemplate x:Key="LifeEventTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding EventType}" Margin="5"/>
                <TextBlock Text="{Binding EventDate}" Margin="5"/>
            </StackPanel>
        </DataTemplate>

        <!-- MarriageEvent DataTemplate -->
        <DataTemplate x:Key="MarriageEventTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding EventType}" Margin="5"/>
                <TextBlock Text="{Binding EventDate}" Margin="5"/>
                <TextBlock Text="{Binding Spouse}" Margin="5" FontWeight="Bold" Foreground="Blue"/>
            </StackPanel>
        </DataTemplate>
        <ObjectDataProvider x:Key="LifeEventTypeEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="model:LifeEventType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <cv:TypeConverter x:Key="TypeConverter"/>
        <cv:PersonToStringConverter x:Key="PersonToStringConverter"/>
        <cv:FamilyToStringConverter x:Key="FamilyToStringConverter"/>
        <cv:AllFamilyToStringConverter x:Key="AllFamilyToStringConverter"/>
        <cv:EnumToCollectionConverter x:Key="EnumToCollectionConverter"/>
        <cv:GenderToImageConverter x:Key="GenderToImageConverter"/>
        <cv:BirthDeathConverter x:Key="BirthDeathConverter"/>
        <cv:HasChildrenToVisibilityConverter x:Key="HasChildrenToVisibilityConverter"/>
        <cv:HasSpouseEventToVisibilityConverter x:Key="HasSpouseEventToVisibilityConverter"/>
    </UserControl.Resources>
        <Grid Background="White">
        <hc:Drawer Dock="Right" ShowMode="Press" IsOpen="{Binding IsDrawerOpen}">
            <Border Background="{DynamicResource RegionBrush}" Width="300" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Background="DarkRed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <TextBlock Margin="10,0,0,0" Text="属性设置" Style="{StaticResource TextBlockTitle}" HorizontalAlignment="Left" Foreground="White"/>
                    <Button Command="hc:ControlCommands.Close" Grid.Row="0" HorizontalAlignment="Right" Style="{StaticResource ButtonIcon}" hc:IconElement.Geometry="{StaticResource DeleteFillCircleGeometry}" Foreground="White"/>
                    <StackPanel Grid.Row="1">
                        <hc:PropertyGrid SelectedObject="{Binding SelectPeople}" />
                        <localui:RandomNameEditor 
Value="{Binding SelectPeople}"
NameSource="{Binding RandomNameList}"
Margin="0,5"/>
                        <UniformGrid Rows="2" Columns="2">
                            <ComboBox VerticalAlignment="Center" Margin="5" ToolTip="双击添加新文化"
                                          hc:TitleElement.Title="文化"
hc:TitleElement.TitlePlacement="Top"
                                                 Style="{StaticResource ComboBoxExtend}"
                                                 ItemsSource="{Binding CultureOptions}" 
                                                 SelectedItem="{Binding SelectPeople.Culture}"
                                                  >
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseDoubleClick">
                                        <i:InvokeCommandAction Command="{Binding AddCultureCommand}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </ComboBox>
                            <ComboBox VerticalAlignment="Center" Margin="5" ToolTip="双击添加新宗教"
                                          hc:TitleElement.Title="宗教"
hc:TitleElement.TitlePlacement="Top"
                                                 Style="{StaticResource ComboBoxExtend}"
                                                 ItemsSource="{Binding ReligionOptions}" 
                                                 SelectedItem="{Binding SelectPeople.Religion}"
                                                  >
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseDoubleClick">
                                        <i:InvokeCommandAction Command="{Binding AddReligionCommand}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </ComboBox>
                            <StackPanel>
                                <TextBlock Text="父亲" Margin="10,0,0,0"/>
                                <ui:AutoSuggestBox x:Name="DadAutoSuggestBox"
            PlaceholderText="搜索人物..." VerticalAlignment="Center" Margin="5"
            Text="{Binding SelectPeople.Dad, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
            ItemsSource="{Binding Suggestions}"
                                    TextChanged="AutoSuggestBox_TextChanged"
    QuerySubmitted="AutoSuggestBox_QuerySubmitted"
    SuggestionChosen="AutoSuggestBox_SuggestionChosen">

                                    <!-- 自定义项目模板 -->
                                    <ui:AutoSuggestBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Column="0" Grid.Row="0"
Text="{Binding IdName}" 
FontWeight="Bold" />
                                                    <TextBlock Opacity="0.6" Foreground="Red" Grid.Row="1" FontSize="10">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="({0} {1})">
                                                                <Binding Path="Name"/>
                                                                <Binding Path="Dynasty"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <TextBlock Grid.Row="2" FontSize="8" Text="{Binding LifeEventList, Mode=OneWay,StringFormat=' {0}', Converter={StaticResource BirthDeathConverter}}" FontWeight="Heavy"/>
                                                </Grid>
                                                <Border Grid.Row="1" 
                    BorderThickness="0,0,0,1" 
                    BorderBrush="#20000000" 
                    Margin="0" />
                                            </Grid>


                                        </DataTemplate>
                                    </ui:AutoSuggestBox.ItemTemplate>
                                </ui:AutoSuggestBox>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="母亲" Margin="10,0,0,0"/>
                                <ui:AutoSuggestBox x:Name="MomAutoSuggestBox"
            PlaceholderText="搜索人物..." VerticalAlignment="Center" Margin="5"
            Text="{Binding SelectPeople.Mom, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
            ItemsSource="{Binding Suggestions}"
                                    TextChanged="AutoSuggestBox_TextChanged"
    QuerySubmitted="AutoSuggestBox_QuerySubmitted"
    SuggestionChosen="AutoSuggestBox_SuggestionChosen">

                                    <!-- 自定义项目模板 -->
                                    <ui:AutoSuggestBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Column="0" Grid.Row="0"
Text="{Binding IdName}" 
FontWeight="Bold" />
                                                    <TextBlock Opacity="0.6" Foreground="Red" Grid.Row="1" FontSize="10">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="({0} {1})">
                                                                <Binding Path="Name"/>
                                                                <Binding Path="Dynasty"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <TextBlock Grid.Row="2" FontSize="8" Text="{Binding LifeEventList, Mode=OneWay,StringFormat=' {0}', Converter={StaticResource BirthDeathConverter}}" FontWeight="Heavy"/>
                                                </Grid>
                                                <Border Grid.Row="1" 
                    BorderThickness="0,0,0,1" 
                    BorderBrush="#20000000" 
                    Margin="0" />
                                            </Grid>


                                        </DataTemplate>
                                    </ui:AutoSuggestBox.ItemTemplate>
                                </ui:AutoSuggestBox>
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel Visibility="{Binding SelectPeople.LifeEventList,Converter={StaticResource HasSpouseEventToVisibilityConverter}}">
                            <TextBlock Text="配偶" Margin="10,0,0,0"/>
                            <ui:AutoSuggestBox x:Name="SpouseAutoSuggestBox"
            PlaceholderText="搜索人物..." VerticalAlignment="Center" Margin="5"
            Text="{Binding SelectPeople.Spouse, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
            ItemsSource="{Binding Suggestions}"
                                    TextChanged="AutoSuggestBox_TextChanged"
    QuerySubmitted="AutoSuggestBox_QuerySubmitted"
    SuggestionChosen="AutoSuggestBox_SuggestionChosen">

                                <!-- 自定义项目模板 -->
                                <ui:AutoSuggestBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Column="0" Grid.Row="0"
Text="{Binding IdName}" 
FontWeight="Bold" />
                                                <TextBlock Opacity="0.6" Foreground="Red" Grid.Row="1" FontSize="10">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="({0} {1})">
                                                            <Binding Path="Name"/>
                                                            <Binding Path="Dynasty"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Grid.Row="2" FontSize="8" Text="{Binding LifeEventList, Mode=OneWay,StringFormat=' {0}', Converter={StaticResource BirthDeathConverter}}" FontWeight="Heavy"/>
                                            </Grid>
                                            <Border Grid.Row="1" 
                    BorderThickness="0,0,0,1" 
                    BorderBrush="#20000000" 
                    Margin="0" />
                                        </Grid>


                                    </DataTemplate>
                                </ui:AutoSuggestBox.ItemTemplate>
                            </ui:AutoSuggestBox>
                        </StackPanel>
                        <TextBlock Text="选中人物的事件列表" FontWeight="Bold" Margin="5,10,0,0" />
                        <DataGrid x:Name="eventsDataGrid" ItemsSource="{Binding SelectPeople.LifeEventList}" HorizontalAlignment="Stretch" SelectedItem="{Binding SelectLifeEvent}"  CanUserAddRows="False" 
                                      >
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="额外信息">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="修改" Style="{StaticResource ButtonSuccess.Small}"
                                                        Command="{Binding DataContext.ModifyLifeEventCmd, 
                                     ElementName=eventsDataGrid}"
                                                        CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <Button Content="修改" Style="{StaticResource ButtonSuccess.Small}"
                                                        Command="{Binding DataContext.ModifyLifeEventCmd, 
                                     ElementName=eventsDataGrid}"
                                                        CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <UniformGrid Columns="2" Rows="1">
                            <Button Content="增加事件" Command="{Binding AddLifeEventCmd}" Style="{StaticResource ButtonSuccess}" HorizontalAlignment="Stretch" Margin="5"/>
                            <Button Content="删除当前选中事件" Command="{Binding DelLifeEventCmd}" Style="{StaticResource ButtonDanger}" HorizontalAlignment="Stretch" Margin="5"/>
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>
        </hc:Drawer>
        <TreeView Grid.Row="1" ItemsSource="{Binding FamilyTree}" SelectedItemChanged="TreeView_SelectedItemChanged"
                  ToolTip="Ctrl+Q修改当前选中人物的信息">
            <TreeView.InputBindings>
                <KeyBinding Key="Q" Modifiers="Ctrl" Command="{Binding ModifyCmd}"/>
            </TreeView.InputBindings>
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <!-- 绑定到 IsExpanded 属性 -->
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type model:People}" ItemsSource="{Binding Children}">
                    <WrapPanel HorizontalAlignment="Left">

                        <Button Style="{StaticResource ButtonIcon.Small}" hc:IconElement.Geometry="{StaticResource AddGeometry}" Foreground="Green"
                                Command="{Binding RelativeSource={RelativeSource AncestorType=TreeView}, Path=DataContext.AddNewChildCmd}"
                                CommandParameter="{Binding}"/>
                        <Button Style="{StaticResource ButtonIcon.Small}" hc:IconElement.Geometry="{StaticResource DeleteGeometry}" Foreground="Red"
        Command="{Binding RelativeSource={RelativeSource AncestorType=TreeView}, Path=DataContext.DelCmd}"
        CommandParameter="{Binding}"
                                Visibility="{Binding Children, Converter={StaticResource HasChildrenToVisibilityConverter}}"/>
                        <Image Source="{Binding Gender, Converter={StaticResource GenderToImageConverter}}" Grid.Column="0" Height="16" Width="16"/>
                        <TextBlock Text="{Binding IdName}" />
                        <TextBlock Text="{Binding Name,StringFormat=' ({0}'}" Opacity="0.6"/>
                        <TextBlock Text="{Binding LifeEventList, Mode=OneWay,StringFormat=' {0}', Converter={StaticResource BirthDeathConverter}}" FontWeight="Heavy"/>
                        <TextBlock Text=")" Opacity="0.6"/>
                    </WrapPanel>
                </HierarchicalDataTemplate>
            </TreeView.Resources>
        </TreeView>
    </Grid>
</UserControl>
