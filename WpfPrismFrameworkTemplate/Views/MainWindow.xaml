<adonisControls:AdonisWindow
    x:Class="WpfPrismFrameworkTemplate.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:ctrlz="clr-namespace:ControlzEx.Behaviors;assembly=ControlzEx"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:viewmodels="clr-namespace:WpfPrismFrameworkTemplate.ViewModels"
    xmlns:cv="clr-namespace:WpfPrismFrameworkTemplate.Converter"
    xmlns:helper="clr-namespace:WpfPrismFrameworkTemplate.Helper"
    xmlns:model="clr-namespace:WpfPrismFrameworkTemplate.Model" 
    xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    xmlns:ui="http://schemas.modernwpf.com/2019"
xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
    Title="{Binding Title}"
    Width="1200"
    Height="700"
    prism:ViewModelLocator.AutoWireViewModel="True"
    TitleBarBackground="DarkRed" TitleBarForeground="White">
    <adonisControls:AdonisWindow.TitleBarContent>
        <WrapPanel Grid.Row="0" VerticalAlignment="Center" Background="DarkRed" HorizontalAlignment="Right">
            <CheckBox Content="与数据库同步" Visibility="Collapsed" IsChecked="{Binding EnableDatabaseSync}" Foreground="White" FontWeight="Heavy" Style="{StaticResource CheckBoxBaseStyle}"/>
            <Button Style="{StaticResource ButtonWarning}" Background="#0000" BorderThickness="0" Foreground="Black" Visibility="Collapsed"
hc:BorderElement.CornerRadius="15" ToolTip="转换到文件内容界面"   Command="{Binding GotoFileContentCmd}"
>
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/fileContent.png" Width="15"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button Style="{StaticResource ButtonWarning}" Background="#0000" BorderThickness="0" Foreground="Black" 
hc:BorderElement.CornerRadius="15" ToolTip="保存所有文件内容"   Command="{Binding SaveAllFileCmd}"
>
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/savefile.png" Width="20"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button Style="{StaticResource ButtonWarning}" Background="#0000" BorderThickness="0" Foreground="Black"
        hc:BorderElement.CornerRadius="15" ToolTip="转换到文件设置界面"   Command="{Binding GotoFileSettingCmd}"
        >
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/fileSetting.png" />
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button Style="{StaticResource ButtonIcon.Small}" hc:IconElement.Geometry="{StaticResource FullScreenGeometry}" Foreground="White"
                    Command="{Binding FullScreenCmd}"/>
            <Button Style="{StaticResource ButtonWarning}" Background="#0000" BorderThickness="0" Foreground="Black" Visibility="Collapsed"
                    hc:BorderElement.CornerRadius="15" ToolTip="转换到图形化界面"   Command="{Binding OpenFileCmd}"
                    >
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/tuxinghua.png"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            
            <Menu HorizontalAlignment="Stretch" Background="DarkRed" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <MenuItem Header="生成" Foreground="White" FontWeight="Heavy">
                    <MenuItem Header="生成个人内容" Command="{Binding CreatePersonContentCmd}" />
                    <MenuItem Header="生成家族内容" Command="{Binding CreateFamilyContentCmd}" />
                    <MenuItem Header="生成整个内容" Command="{Binding CreateAllFamilyContentCmd}" />
                </MenuItem>
                <MenuItem Header="输出" Foreground="White" FontWeight="Heavy">
                    <MenuItem Header="输出个人内容" Command="{Binding OutputPersonContentCmd}" />
                    <MenuItem Header="输出家族内容" Command="{Binding OutputFamilyContentCmd}" />
                    <MenuItem Header="输出整个内容" Command="{Binding OutputAllFamilyContentCmd}" />
                </MenuItem>
                <MenuItem Header="编辑" Foreground="White" FontWeight="Heavy">
                    <MenuItem Header="添加家族" Command="{Binding AddFamilyCmd}" />
                    <MenuItem Header="删除家族" Command="{Binding DelFamilyCmd}" />
                    <MenuItem Header="添加人物" Command="{Binding AddPeopleCmd}" />
                    <MenuItem Header="删除人物" Command="{Binding DelPeopleCmd}" />
                </MenuItem>
            </Menu>
        </WrapPanel>
    </adonisControls:AdonisWindow.TitleBarContent>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closed">
            <i:InvokeCommandAction Command="{Binding CloseCommand}"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    
    <Window.Resources>
        <DataTemplate x:Key="LifeEventTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding EventType}" Margin="5"/>
                <TextBlock Text="{Binding EventDate}" Margin="5"/>
            </StackPanel>
        </DataTemplate>

        <!-- MarriageEvent DataTemplate -->
        <DataTemplate x:Key="MarriageEventTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding EventType}" Margin="5"/>
                <TextBlock Text="{Binding EventDate}" Margin="5"/>
                <TextBlock Text="{Binding Spouse}" Margin="5" FontWeight="Bold" Foreground="Blue"/>
            </StackPanel>
        </DataTemplate>

        <ObjectDataProvider x:Key="LifeEventTypeEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="model:LifeEventType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <cv:TypeConverter x:Key="TypeConverter"/>
        <cv:PersonToStringConverter x:Key="PersonToStringConverter"/>
        <cv:FamilyToStringConverter x:Key="FamilyToStringConverter"/>
        <cv:AllFamilyToStringConverter x:Key="AllFamilyToStringConverter"/>
        <cv:EnumToCollectionConverter x:Key="EnumToCollectionConverter"/>
        <cv:GenderToImageConverter x:Key="GenderToImageConverter"/>
        <cv:BirthDeathConverter x:Key="BirthDeathConverter"/>
        <cv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <cv:ObjectToVisibilityConverter x:Key="ObjectToVisibilityConverter"/>
        <cv:HasSpouseEventToVisibilityConverter x:Key="HasSpouseEventToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <TreeView ItemsSource="{Binding FamilyList}" SelectedItemChanged="TreeView_SelectedItemChanged"  dd:DragDrop.IsDragSource="True" Grid.Column="0" Grid.Row="0"
         dd:DragDrop.IsDropTarget="True" HorizontalContentAlignment="Left" Style="{StaticResource TreeView.Small}">
                    <TreeView.Resources>
                        <!-- 家族模板 -->
                        <HierarchicalDataTemplate DataType="{x:Type model:Family}"
                                        ItemsSource="{Binding Members}">
                            <StackPanel Orientation="Horizontal">
                            <StackPanel.ToolTip>
                                <ToolTip>
                                    <Border BorderBrush="Black" BorderThickness="1" Background="White" Padding="5">
                                        <Image Source="/Images/tuxinghua.png" Width="200" Height="150" Stretch="Uniform"/>
                                    </Border>
                                </ToolTip>
                            </StackPanel.ToolTip>
                                <TextBlock Text="{Binding FamilyName}" 
                                 FontWeight="Bold"/>
                                <TextBlock Text="{Binding Members.Count, 
                                 StringFormat=' ({0} members)'}"
                                 Opacity="0.6"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>

                        <!-- 成员模板 -->
                        <DataTemplate DataType="{x:Type model:People}">
                        <WrapPanel HorizontalAlignment="Left">
                            <Image Source="{Binding Gender, Converter={StaticResource GenderToImageConverter}}" Grid.Column="0" Height="16" Width="16"/>
                            <TextBlock Text="{Binding IdName}" />
                            <TextBlock Text="{Binding Name,StringFormat=' ({0}'}" Opacity="0.6"/>
                            <TextBlock Text="{Binding LifeEventList, Mode=OneWay,StringFormat=' {0}', Converter={StaticResource BirthDeathConverter}}" FontWeight="Heavy"/>
                            <TextBlock Text=")" Opacity="0.6"/>
                        </WrapPanel>
                            
                            
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>
            <TabControl Foreground="Black" Grid.Column="1" Grid.Row="0">
                <hc:TabItem Header="属性设置"  Foreground="Black" FontWeight="Heavy">
                    <hc:ScrollViewer >
                        <StackPanel>
                            <hc:PropertyGrid SelectedObject="{Binding SelectPeople}" />
                            <UniformGrid Rows="2" Columns="2">
                                <ComboBox VerticalAlignment="Center" Margin="5" ToolTip="双击添加新文化"
                                          hc:TitleElement.Title="文化"
hc:TitleElement.TitlePlacement="Top"
                                                 Style="{StaticResource ComboBoxExtend}"
                                                 ItemsSource="{Binding CultureOptions}" 
                                                 SelectedItem="{Binding SelectPeople.Culture}"
                                                  >
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="MouseDoubleClick">
                                            <i:InvokeCommandAction Command="{Binding AddCultureCommand}"/>
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </ComboBox>
                                <ComboBox VerticalAlignment="Center" Margin="5" ToolTip="双击添加新宗教"
                                          hc:TitleElement.Title="宗教"
hc:TitleElement.TitlePlacement="Top"
                                                 Style="{StaticResource ComboBoxExtend}"
                                                 ItemsSource="{Binding ReligionOptions}" 
                                                 SelectedItem="{Binding SelectPeople.Religion}"
                                                  >
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="MouseDoubleClick">
                                            <i:InvokeCommandAction Command="{Binding AddReligionCommand}"/>
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </ComboBox>
                                <StackPanel>
                                    <TextBlock Text="父亲" Margin="10,0,0,0"/>
                                    <ui:AutoSuggestBox x:Name="DadAutoSuggestBox"
            PlaceholderText="搜索人物..." VerticalAlignment="Center" Margin="5"
            Text="{Binding SelectPeople.Dad, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
            ItemsSource="{Binding Suggestions}"
                                    TextChanged="AutoSuggestBox_TextChanged"
    QuerySubmitted="AutoSuggestBox_QuerySubmitted"
    SuggestionChosen="AutoSuggestBox_SuggestionChosen">

                                        <!-- 自定义项目模板 -->
                                        <ui:AutoSuggestBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Column="0" Grid.Row="0"
Text="{Binding IdName}" 
FontWeight="Bold" />
                                                        <TextBlock Opacity="0.6" Foreground="Red" Grid.Row="1" FontSize="10">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="({0} {1})">
                                                                    <Binding Path="Name"/>
                                                                    <Binding Path="Dynasty"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <TextBlock Grid.Row="2" FontSize="8" Text="{Binding LifeEventList, Mode=OneWay,StringFormat=' {0}', Converter={StaticResource BirthDeathConverter}}" FontWeight="Heavy"/>
                                                    </Grid>
                                                    <Border Grid.Row="1" 
                    BorderThickness="0,0,0,1" 
                    BorderBrush="#20000000" 
                    Margin="0" />
                                                </Grid>


                                            </DataTemplate>
                                        </ui:AutoSuggestBox.ItemTemplate>
                                    </ui:AutoSuggestBox>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="母亲" Margin="10,0,0,0"/>
                                    <ui:AutoSuggestBox x:Name="MomAutoSuggestBox"
            PlaceholderText="搜索人物..." VerticalAlignment="Center" Margin="5"
            Text="{Binding SelectPeople.Mom, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
            ItemsSource="{Binding Suggestions}"
                                    TextChanged="AutoSuggestBox_TextChanged"
    QuerySubmitted="AutoSuggestBox_QuerySubmitted"
    SuggestionChosen="AutoSuggestBox_SuggestionChosen">

                                        <!-- 自定义项目模板 -->
                                        <ui:AutoSuggestBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Column="0" Grid.Row="0"
Text="{Binding IdName}" 
FontWeight="Bold" />
                                                        <TextBlock Opacity="0.6" Foreground="Red" Grid.Row="1" FontSize="10">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="({0} {1})">
                                                                    <Binding Path="Name"/>
                                                                    <Binding Path="Dynasty"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <TextBlock Grid.Row="2" FontSize="8" Text="{Binding LifeEventList, Mode=OneWay,StringFormat=' {0}', Converter={StaticResource BirthDeathConverter}}" FontWeight="Heavy"/>
                                                    </Grid>
                                                    <Border Grid.Row="1" 
                    BorderThickness="0,0,0,1" 
                    BorderBrush="#20000000" 
                    Margin="0" />
                                                </Grid>


                                            </DataTemplate>
                                        </ui:AutoSuggestBox.ItemTemplate>
                                    </ui:AutoSuggestBox>
                                </StackPanel>
                            </UniformGrid>
                            <StackPanel Visibility="{Binding SelectPeople.LifeEventList,Converter={StaticResource HasSpouseEventToVisibilityConverter}}">
                                <TextBlock Text="配偶" Margin="10,0,0,0"/>
                                <ui:AutoSuggestBox x:Name="SpouseAutoSuggestBox"
            PlaceholderText="搜索人物..." VerticalAlignment="Center" Margin="5"
            Text="{Binding SelectPeople.Spouse, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
            ItemsSource="{Binding Suggestions}"
                                    TextChanged="AutoSuggestBox_TextChanged"
    QuerySubmitted="AutoSuggestBox_QuerySubmitted"
    SuggestionChosen="AutoSuggestBox_SuggestionChosen">

                                    <!-- 自定义项目模板 -->
                                    <ui:AutoSuggestBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Column="0" Grid.Row="0"
Text="{Binding IdName}" 
FontWeight="Bold" />
                                                    <TextBlock Opacity="0.6" Foreground="Red" Grid.Row="1" FontSize="10">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="({0} {1})">
                                                                <Binding Path="Name"/>
                                                                <Binding Path="Dynasty"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <TextBlock Grid.Row="2" FontSize="8" Text="{Binding LifeEventList, Mode=OneWay,StringFormat=' {0}', Converter={StaticResource BirthDeathConverter}}" FontWeight="Heavy"/>
                                                </Grid>
                                                <Border Grid.Row="1" 
                    BorderThickness="0,0,0,1" 
                    BorderBrush="#20000000" 
                    Margin="0" />
                                            </Grid>


                                        </DataTemplate>
                                    </ui:AutoSuggestBox.ItemTemplate>
                                </ui:AutoSuggestBox>
                            </StackPanel>
                            <TextBlock Text="选中人物的事件列表" FontWeight="Bold" Margin="0,5,0,0" />
                            <DataGrid x:Name="eventsDataGrid" ItemsSource="{Binding SelectPeople.LifeEventList}" HorizontalAlignment="Stretch" SelectedItem="{Binding SelectLifeEvent}"  CanUserAddRows="False" 
                                      >
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="额外信息">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="修改" Style="{StaticResource ButtonSuccess.Small}"
                                                        Command="{Binding DataContext.ModifyLifeEventCmd, 
                                     ElementName=eventsDataGrid}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <Button Content="修改" Style="{StaticResource ButtonSuccess.Small}"
                                                        Command="{Binding DataContext.ModifyLifeEventCmd, 
                                     ElementName=eventsDataGrid}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <UniformGrid Columns="2" Rows="1">
                                <Button Content="增加事件" Command="{Binding AddLifeEventCmd}" Style="{StaticResource ButtonSuccess}" HorizontalAlignment="Stretch" Margin="5"/>
                                <Button Content="删除当前选中事件" Command="{Binding DelLifeEventCmd}" Style="{StaticResource ButtonDanger}" HorizontalAlignment="Stretch" Margin="5"/>
                            </UniformGrid>

                        </StackPanel>

                    </hc:ScrollViewer>

                </hc:TabItem>
                <hc:TabItem Header="文件设置" Foreground="Black" FontWeight="Heavy">
                    <ContentControl prism:RegionManager.RegionName="FileSettingRegion" />
                </hc:TabItem>
            </TabControl>

            <TabControl Foreground="Black" dd:DragDrop.IsDragSource="True" Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"
         dd:DragDrop.IsDropTarget="True" >
                <hc:TabItem Header="实时个人内容"  Foreground="Black" FontWeight="Heavy">
                    <TextBox Margin="5" Text="{Binding SelectPeople.DisplayText,Mode=OneWay}" IsReadOnly="True"/>
                </hc:TabItem>

                <!--<hc:TabItem Header="单个家族"  Foreground="Black" FontWeight="Heavy">
                    <TextBox Margin="5" Text="{Binding SelectFamily, Converter={StaticResource FamilyToStringConverter}}"  IsReadOnly="True"/>
                </hc:TabItem>
                <hc:TabItem Header="全部家族"  Foreground="Black" FontWeight="Heavy">
                    <TextBox Margin="5" Text="{Binding FamilyList, Converter={StaticResource AllFamilyToStringConverter}}" IsReadOnly="True"/>
                </hc:TabItem>-->
                <hc:TabItem Header="实时文件内容"  Foreground="Black" FontWeight="Heavy">
                    <ContentControl prism:RegionManager.RegionName="FileContentRegion" />
                </hc:TabItem>

            </TabControl>
            <ContentControl Grid.Column="0" Grid.ColumnSpan="4" prism:RegionManager.RegionName="ContentRegion" />
        </Grid>

        
        
    </Grid>
</adonisControls:AdonisWindow>
