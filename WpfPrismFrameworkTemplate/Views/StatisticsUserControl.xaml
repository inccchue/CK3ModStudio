<UserControl x:Class="WpfPrismFrameworkTemplate.Views.StatisticsUserControl"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:ctrlz="clr-namespace:ControlzEx.Behaviors;assembly=ControlzEx"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:viewmodels="clr-namespace:WpfPrismFrameworkTemplate.ViewModels"
    xmlns:cv="clr-namespace:WpfPrismFrameworkTemplate.Converter"
    xmlns:model="clr-namespace:WpfPrismFrameworkTemplate.Model" 
    xmlns:helper="clr-namespace:WpfPrismFrameworkTemplate.Helper"
    xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    xmlns:ui="http://schemas.modernwpf.com/2019"
xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"          
             prism:ViewModelLocator.AutoWireViewModel="True" >
    <UserControl.Resources>
        <cv:StatisTypeAndHeaderToVisibilityConverter x:Key="StatisTypeAndHeaderToVisibilityConverter"/>
        
    </UserControl.Resources>
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!--<RowDefinition Height="30"/>-->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <hc:SideMenu BorderThickness="1">
            <hc:SideMenuItem Header="家族统计数据" FontSize="16" FontWeight="Heavy">
                <hc:SideMenuItem.Icon>
                    <Image Source="/Images/family.png" Width="24" Height="24"/>
                </hc:SideMenuItem.Icon>
                <hc:SideMenuItem Header="各家族人数" Command="{Binding SelectCmd}" CommandParameter="{Binding Header,RelativeSource={RelativeSource Self}}">
                </hc:SideMenuItem>
            </hc:SideMenuItem>
            <hc:SideMenuItem Header="杂项统计数据" FontSize="16" FontWeight="Heavy">
                <hc:SideMenuItem.Icon>
                    <Image Source="/Images/misc.png" Width="24" Height="24"/>
                </hc:SideMenuItem.Icon>
                <hc:SideMenuItem Header="各文化人数" Command="{Binding SelectCmd}" CommandParameter="{Binding Header,RelativeSource={RelativeSource Self}}">
                </hc:SideMenuItem>
            </hc:SideMenuItem>
        </hc:SideMenu>
        <Grid Grid.Column="1" x:Name="各家族人数" Margin="10">
            <Grid.Visibility>
                <MultiBinding Converter="{StaticResource StatisTypeAndHeaderToVisibilityConverter}">
                    <Binding Path="SelectedStatisType" />
                    <Binding RelativeSource="{RelativeSource Self}" Path="Name" />
                </MultiBinding>
            </Grid.Visibility>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="各家族人数" HorizontalAlignment="Center" FontWeight="Heavy" VerticalAlignment="Center"/>
            <lvc:CartesianChart Padding="5" VerticalContentAlignment="Stretch" Grid.Row="1">

                <lvc:CartesianChart.Series>

                    <lvc:ColumnSeries
Values="{Binding SeriesValues}" >

                    </lvc:ColumnSeries>

                </lvc:CartesianChart.Series>
                <lvc:CartesianChart.AxisX>
                    <lvc:Axis Labels="{Binding XLabels}"  FontWeight="Heavy"
            ShowLabels="True"
            Foreground="Black"
            FontSize="12"
            >
                        <!--设置显示步长-->
                        <lvc:Axis.Separator>
                            <lvc:Separator Step="1" StrokeThickness="0"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisX>
            </lvc:CartesianChart>
        </Grid>
        <Grid Grid.Column="1" x:Name="各文化人数" Margin="10">
            <Grid.Visibility>
                <MultiBinding Converter="{StaticResource StatisTypeAndHeaderToVisibilityConverter}">
                    <Binding Path="SelectedStatisType" />
                    <Binding RelativeSource="{RelativeSource Self}" Path="Name" />
                </MultiBinding>
            </Grid.Visibility>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="各文化人数" HorizontalAlignment="Center" FontWeight="Heavy" VerticalAlignment="Center"/>
            <lvc:CartesianChart Grid.Row="1" Padding="5">
                <lvc:PieChart LegendLocation="Bottom" Series="{Binding PieSeriesCollection}">
                </lvc:PieChart>
            </lvc:CartesianChart>
        </Grid>

    </Grid>
</UserControl>
