<Window x:Class="WpfPrismFrameworkTemplate.Views.MoveLandedTitleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="480" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E2E">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#45475A"/>
                                <Setter Property="Foreground" Value="#6C7086"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#313244" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="移动法理" FontSize="11" Foreground="#6C7086" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding SourceTitle.Key}" FontSize="16" FontWeight="Bold" Foreground="#CDD6F4"/>
                <TextBlock Text="{Binding SourceTitle.RankLabel}" FontSize="12" Foreground="#89B4FA"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1" Text="{Binding Instruction}"
                   Foreground="#A6E3A1" FontSize="13" Margin="0,0,0,10"/>

        <Border Grid.Row="2" Background="#313244" BorderBrush="#45475A" BorderThickness="1"
                CornerRadius="6" Padding="8,5" Margin="0,0,0,8">
            <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     Background="Transparent" BorderThickness="0"
                     Foreground="#CDD6F4" FontSize="12"/>
        </Border>

        <ListBox Grid.Row="3" ItemsSource="{Binding FilteredTargets}"
                 SelectedItem="{Binding SelectedTarget}"
                 Background="#313244" BorderBrush="#45475A" Foreground="#CDD6F4"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#89B4FA"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1E1E2E"/>
            </ListBox.Resources>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4,4">
                        <TextBlock Text="{Binding RankIcon}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="{Binding Key}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{Binding RankLabel}" FontSize="11" Opacity="0.7"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="取消" Click="Cancel_Click"
                    Background="#F38BA8" Foreground="#1E1E2E"/>
            <Button Grid.Column="2" Content="确认移动" Click="Confirm_Click"
                    Background="#89B4FA" Foreground="#1E1E2E"
                    IsEnabled="{Binding CanConfirm}"/>
        </Grid>
    </Grid>
</Window>
