<Window x:Class="WpfPrismFrameworkTemplate.Views.AddLandedTitleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增法理"
        Width="500" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E2E">
    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#45475A"/>
                                <Setter Property="Foreground" Value="#6C7086"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecBtn" TargetType="Button">
            <Setter Property="Background" Value="#F38BA8"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#89B4FA"/>
                    <Setter Property="Foreground" Value="#1E1E2E"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45475A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="新增法理" FontSize="18" FontWeight="Bold" Foreground="#CDD6F4" Margin="0,0,0,16"/>

            <!-- Key preview -->
            <Border Background="#313244" CornerRadius="8" Padding="12,8" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtPrefix" Text="c_" FontSize="18" FontWeight="Bold" Foreground="#89B4FA" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtPreview" Text="…" FontSize="18" FontWeight="Bold" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border x:Name="ErrBorder" Background="#3B0000" BorderBrush="#F38BA8" BorderThickness="1"
                    CornerRadius="6" Padding="8,5" Margin="0,0,0,8" Visibility="Collapsed">
                <TextBlock x:Name="TxtError" Foreground="#F38BA8" FontSize="12"/>
            </Border>

            <!-- Rank selection -->
            <TextBlock Style="{StaticResource Lbl}" Text="等级"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border x:Name="BtnEmpire" Tag="Empire" Background="#313244" CornerRadius="6" Padding="12,6" Margin="0,0,8,0"
                        Cursor="Hand" MouseLeftButtonDown="RankBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👑" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="帝国" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border x:Name="BtnKingdom" Tag="Kingdom" Background="#313244" CornerRadius="6" Padding="12,6" Margin="0,0,8,0"
                        Cursor="Hand" MouseLeftButtonDown="RankBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏰" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="王国" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border x:Name="BtnDuchy" Tag="Duchy" Background="#313244" CornerRadius="6" Padding="12,6" Margin="0,0,8,0"
                        Cursor="Hand" MouseLeftButtonDown="RankBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚜" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="公国" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border x:Name="BtnCounty" Tag="County" Background="#313244" CornerRadius="6" Padding="12,6"
                        Cursor="Hand" MouseLeftButtonDown="RankBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏛" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="伯国" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Key suffix -->
            <TextBlock Style="{StaticResource Lbl}" Text="键值后缀"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="#45475A" CornerRadius="6,0,0,6" Padding="8,6" VerticalAlignment="Stretch">
                    <TextBlock x:Name="PrefixBox" Text="c_" Foreground="#89B4FA" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                </Border>
                <TextBox x:Name="TxtKeySuffix" Grid.Column="1" Style="{StaticResource InputBox}"
                         TextChanged="KeySuffix_Changed"/>
            </Grid>

            <!-- Capital -->
            <TextBlock Style="{StaticResource Lbl}" Text="首都 (可选)"/>
            <TextBox x:Name="TxtCapital" Style="{StaticResource InputBox}" Margin="0,0,0,12"/>

            <!-- Color -->
            <TextBlock Style="{StaticResource Lbl}" Text="颜色 (RGB 0-255)"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border x:Name="ColorPreview" Width="36" Height="36" CornerRadius="6" Background="Gray" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtR" Style="{StaticResource InputBox}" Width="60" Margin="0,0,6,0"
                         TextChanged="Color_Changed"/>
                <TextBox x:Name="TxtG" Style="{StaticResource InputBox}" Width="60" Margin="0,0,6,0"
                         TextChanged="Color_Changed"/>
                <TextBox x:Name="TxtB" Style="{StaticResource InputBox}" Width="60"
                         TextChanged="Color_Changed"/>
            </StackPanel>

            <!-- Definite form -->
            <CheckBox x:Name="ChkDefinite" Content="definite_form" Foreground="#CDD6F4" Margin="0,0,0,12"/>

            <!-- Parent selection -->
            <StackPanel x:Name="ParentPanel" Margin="0,0,0,12">
                <TextBlock Style="{StaticResource Lbl}" Text="父级法理"/>
                <Grid Margin="0,0,0,6">
                    <TextBlock x:Name="ParentSearchHint" Text="搜索父级..." Foreground="#6C7086" FontSize="12"
                               IsHitTestVisible="False" Margin="8,6,0,0"/>
                    <TextBox x:Name="TxtParentSearch" Background="#313244" BorderBrush="#45475A" BorderThickness="1"
                             Foreground="#CDD6F4" FontSize="12" Padding="8,6"
                             TextChanged="ParentSearch_Changed"/>
                </Grid>
                <ListBox x:Name="ParentList" Background="#313244" BorderBrush="#45475A" Height="120"
                         Foreground="#CDD6F4" SelectionChanged="ParentList_SelectionChanged">
                    <ListBox.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#89B4FA"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1E1E2E"/>
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding RankIcon}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Key}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="取消" Style="{StaticResource SecBtn}" Click="Cancel_Click"/>
                <Button x:Name="BtnConfirm" Grid.Column="2" Content="确认" Style="{StaticResource PrimaryBtn}"
                        IsEnabled="False" Click="Confirm_Click"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
