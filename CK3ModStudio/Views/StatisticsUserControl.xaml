<UserControl x:Class="WpfPrismFrameworkTemplate.Views.StatisticsUserControl"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:cv="clr-namespace:WpfPrismFrameworkTemplate.Converter"
    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
    prism:ViewModelLocator.AutoWireViewModel="True" >
    <UserControl.Resources>
        <cv:StatisTypeAndHeaderToVisibilityConverter x:Key="StatisTypeAndHeaderToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <hc:SideMenu BorderThickness="1">
            <hc:SideMenuItem Header="家族统计数据" FontSize="16" FontWeight="Heavy">
                <hc:SideMenuItem.Icon>
                    <Image Source="/Images/family.png" Width="24" Height="24"/>
                </hc:SideMenuItem.Icon>
                <hc:SideMenuItem Header="各家族人数" Command="{Binding SelectCmd}" CommandParameter="{Binding Header,RelativeSource={RelativeSource Self}}"/>
                <hc:SideMenuItem Header="各家族平均寿命" Command="{Binding SelectCmd}" CommandParameter="{Binding Header,RelativeSource={RelativeSource Self}}"/>
            </hc:SideMenuItem>
            <hc:SideMenuItem Header="杂项统计数据" FontSize="16" FontWeight="Heavy">
                <hc:SideMenuItem.Icon>
                    <Image Source="/Images/misc.png" Width="24" Height="24"/>
                </hc:SideMenuItem.Icon>
                <hc:SideMenuItem Header="各文化人数" Command="{Binding SelectCmd}" CommandParameter="{Binding Header,RelativeSource={RelativeSource Self}}"/>
                <hc:SideMenuItem Header="各宗教人数" Command="{Binding SelectCmd}" CommandParameter="{Binding Header,RelativeSource={RelativeSource Self}}"/>
                <hc:SideMenuItem Header="性别比例" Command="{Binding SelectCmd}" CommandParameter="{Binding Header,RelativeSource={RelativeSource Self}}"/>
            </hc:SideMenuItem>
        </hc:SideMenu>

        <!-- 各家族人数 -->
        <Grid Grid.Column="1" x:Name="各家族人数" Margin="10">
            <Grid.Visibility>
                <MultiBinding Converter="{StaticResource StatisTypeAndHeaderToVisibilityConverter}">
                    <Binding Path="SelectedStatisType" />
                    <Binding RelativeSource="{RelativeSource Self}" Path="Name" />
                </MultiBinding>
            </Grid.Visibility>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="各家族人数" HorizontalAlignment="Center" FontWeight="Heavy" VerticalAlignment="Center"/>
            <lvc:CartesianChart Grid.Row="1" Padding="5">
                <lvc:CartesianChart.Series>
                    <lvc:ColumnSeries Values="{Binding SeriesValues}" DataLabels="True"/>
                </lvc:CartesianChart.Series>
                <lvc:CartesianChart.AxisX>
                    <lvc:Axis Labels="{Binding XLabels}"
                              FontWeight="Heavy"
                              ShowLabels="True"
                              Foreground="Black"
                              FontSize="12"
                              LabelsRotation="-45">
                        <lvc:Axis.Separator>
                            <lvc:Separator Step="1" StrokeThickness="0"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisX>
                <lvc:CartesianChart.AxisY>
                    <lvc:Axis Title="人数" MinValue="0">
                        <lvc:Axis.Separator>
                            <lvc:Separator Step="1"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisY>
            </lvc:CartesianChart>
        </Grid>

        <!-- 各家族平均寿命 -->
        <Grid Grid.Column="1" x:Name="各家族平均寿命" Margin="10">
            <Grid.Visibility>
                <MultiBinding Converter="{StaticResource StatisTypeAndHeaderToVisibilityConverter}">
                    <Binding Path="SelectedStatisType" />
                    <Binding RelativeSource="{RelativeSource Self}" Path="Name" />
                </MultiBinding>
            </Grid.Visibility>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="各家族平均寿命（仅统计有完整出生/死亡记录的人）" HorizontalAlignment="Center" FontWeight="Heavy" VerticalAlignment="Center"/>
            <lvc:CartesianChart Grid.Row="1" Padding="5">
                <lvc:CartesianChart.Series>
                    <lvc:ColumnSeries Values="{Binding AvgAgeValues}" DataLabels="True" Title="平均寿命（岁）"/>
                </lvc:CartesianChart.Series>
                <lvc:CartesianChart.AxisX>
                    <lvc:Axis Labels="{Binding AvgAgeLabels}"
                              FontWeight="Heavy"
                              ShowLabels="True"
                              Foreground="Black"
                              FontSize="12"
                              LabelsRotation="-45">
                        <lvc:Axis.Separator>
                            <lvc:Separator Step="1" StrokeThickness="0"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisX>
                <lvc:CartesianChart.AxisY>
                    <lvc:Axis Title="岁" MinValue="0"/>
                </lvc:CartesianChart.AxisY>
            </lvc:CartesianChart>
        </Grid>

        <!-- 各文化人数 -->
        <Grid Grid.Column="1" x:Name="各文化人数" Margin="10">
            <Grid.Visibility>
                <MultiBinding Converter="{StaticResource StatisTypeAndHeaderToVisibilityConverter}">
                    <Binding Path="SelectedStatisType" />
                    <Binding RelativeSource="{RelativeSource Self}" Path="Name" />
                </MultiBinding>
            </Grid.Visibility>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="各文化人数" HorizontalAlignment="Center" FontWeight="Heavy" VerticalAlignment="Center"/>
            <lvc:PieChart Grid.Row="1" LegendLocation="Bottom" Series="{Binding PieSeriesCollection}" DataTooltip="{x:Null}"/>
        </Grid>

        <!-- 各宗教人数 -->
        <Grid Grid.Column="1" x:Name="各宗教人数" Margin="10">
            <Grid.Visibility>
                <MultiBinding Converter="{StaticResource StatisTypeAndHeaderToVisibilityConverter}">
                    <Binding Path="SelectedStatisType" />
                    <Binding RelativeSource="{RelativeSource Self}" Path="Name" />
                </MultiBinding>
            </Grid.Visibility>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="各宗教人数" HorizontalAlignment="Center" FontWeight="Heavy" VerticalAlignment="Center"/>
            <lvc:PieChart Grid.Row="1" LegendLocation="Bottom" Series="{Binding ReligionPieSeriesCollection}" DataTooltip="{x:Null}"/>
        </Grid>

        <!-- 性别比例 -->
        <Grid Grid.Column="1" x:Name="性别比例" Margin="10">
            <Grid.Visibility>
                <MultiBinding Converter="{StaticResource StatisTypeAndHeaderToVisibilityConverter}">
                    <Binding Path="SelectedStatisType" />
                    <Binding RelativeSource="{RelativeSource Self}" Path="Name" />
                </MultiBinding>
            </Grid.Visibility>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="性别比例" HorizontalAlignment="Center" FontWeight="Heavy" VerticalAlignment="Center"/>
            <lvc:PieChart Grid.Row="1" LegendLocation="Bottom" Series="{Binding GenderPieSeriesCollection}" DataTooltip="{x:Null}"/>
        </Grid>

    </Grid>
</UserControl>
