<Window x:Class="WpfPrismFrameworkTemplate.Views.GenerateSubmodDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cv="clr-namespace:WpfPrismFrameworkTemplate.Converter"
        Title="生成子mod文件"
        Width="800" Height="700"
        MinWidth="700" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="#1E2740">
    <Window.Resources>
        <cv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="DlgBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7A8FC0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="DlgInput" TargetType="TextBox">
            <Setter Property="Background" Value="#2B3452"/>
            <Setter Property="Foreground" Value="#D8E2F5"/>
            <Setter Property="BorderBrush" Value="#48577A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="CaretBrush" Value="#7EB3F7"/>
        </Style>

        <Style x:Key="ReadonlyField" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D8E2F5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#1A2236"/>
            <Setter Property="Padding" Value="7,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 标题 -->
            <RowDefinition Height="Auto"/>
            <!-- 路径 -->
            <RowDefinition Height="Auto"/>
            <!-- 伯国信息 -->
            <RowDefinition Height="Auto"/>
            <!-- 设置 -->
            <RowDefinition Height="*"/>
            <!-- 男爵领表格 -->
            <RowDefinition Height="Auto"/>
            <!-- 按钮 -->
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#2B3A5C" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚜" FontSize="22" Foreground="#7EB3F7" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="生成 AGOT 子mod文件" FontSize="15" FontWeight="Bold" Foreground="#D8E2F5"/>
                    <TextBlock x:Name="TxtCountyKeyHeader" FontSize="11" Foreground="#7A8FC0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 路径设置 -->
        <Border Grid.Row="1" Background="#222B44" CornerRadius="7" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="子mod路径" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource DlgInput}"
                                 Text="{Binding SubmodPath, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Content="…" Click="BrowseSubmod_Click"
                                Style="{StaticResource DlgBtn}" Background="#364063" Foreground="#D8E2F5"
                                Padding="10,5" FontSize="13" ToolTip="选择子mod文件夹"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="AGOT主mod路径" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource DlgInput}"
                                 Text="{Binding AgotModPath, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Content="…" Click="BrowseAgot_Click"
                                Style="{StaticResource DlgBtn}" Background="#364063" Foreground="#D8E2F5"
                                Padding="10,5" FontSize="13" ToolTip="选择AGOT主mod文件夹"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 伯国信息（只读） -->
        <Border Grid.Row="2" Background="#222B44" CornerRadius="7" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="伯国" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="TxtCountyKey" Style="{StaticResource ReadonlyField}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="公国" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="TxtDuchyKey" Style="{StaticResource ReadonlyField}"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="王国" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="TxtKingdomKey" Style="{StaticResource ReadonlyField}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主设置 -->
        <Border Grid.Row="3" Background="#222B44" CornerRadius="7" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="英文名 (伯国)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource DlgInput}"
                             Text="{Binding EnglishName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="中文名 (伯国)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource DlgInput}"
                             Text="{Binding ChineseName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="发展度" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource DlgInput}"
                             Text="{Binding DevelopmentLevel, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBlock Text="文化 (culture)" Style="{StaticResource FieldLabel}" Margin="0"/>
                        <TextBlock Text=" ⟳" Foreground="#7EB3F7" FontSize="11" VerticalAlignment="Center"
                                   Visibility="{Binding IsLoadingLists, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                    <ComboBox IsEditable="True"
                              Text="{Binding Culture, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding Cultures}"
                              Background="#2B3452" Foreground="#D8E2F5"
                              BorderBrush="#48577A" BorderThickness="1"
                              FontSize="12" FocusVisualStyle="{x:Null}"/>
                </StackPanel>
                <StackPanel Grid.Column="8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBlock Text="宗教 (religion)" Style="{StaticResource FieldLabel}" Margin="0"/>
                        <TextBlock Text=" ⟳" Foreground="#7EB3F7" FontSize="11" VerticalAlignment="Center"
                                   Visibility="{Binding IsLoadingLists, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                    <ComboBox IsEditable="True"
                              Text="{Binding Religion, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding Religions}"
                              Background="#2B3452" Foreground="#D8E2F5"
                              BorderBrush="#48577A" BorderThickness="1"
                              FontSize="12" FocusVisualStyle="{x:Null}"/>
                </StackPanel>
                <StackPanel Grid.Column="10">
                    <TextBlock Text="历史文件区域名" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource DlgInput}"
                             Text="{Binding TitleHistoryRegion, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="写入 xsy_titles_{region}.txt，如 the_stormlands"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 男爵领表格 -->
        <Border Grid.Row="4" Background="#222B44" CornerRadius="7" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 参考伯国行 -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="参考伯国键（复制统治者历史）" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource DlgInput}"
                                 Text="{Binding ReferenceCountyKey, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="同一公国下的参考伯国，如 c_storms_end；留空则跳过统治者历史"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="提示" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="男爵领的英文/中文名和建筑等级请在下表填写" Foreground="#7A8FC0" FontSize="11" VerticalAlignment="Center" Padding="7,5"/>
                    </StackPanel>
                </Grid>

                <!-- 表头 -->
                <Grid Grid.Row="1" Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="男爵领键" Style="{StaticResource FieldLabel}" Padding="4,0"/>
                    <TextBlock Grid.Column="1" Text="省份ID" Style="{StaticResource FieldLabel}" Padding="4,0"/>
                    <TextBlock Grid.Column="2" Text="英文名" Style="{StaticResource FieldLabel}" Padding="4,0"/>
                    <TextBlock Grid.Column="3" Text="中文名" Style="{StaticResource FieldLabel}" Padding="4,0"/>
                    <TextBlock Grid.Column="4" Text="建筑等级" Style="{StaticResource FieldLabel}" Padding="4,0"/>
                </Grid>

                <!-- 男爵领列表 -->
                <DataGrid Grid.Row="2"
                          x:Name="BaroniesGrid"
                          ItemsSource="{Binding Baronies}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="None"
                          GridLinesVisibility="None"
                          Background="#1E2740"
                          RowBackground="#222B44"
                          AlternatingRowBackground="#263050"
                          Foreground="#D8E2F5"
                          BorderThickness="0"
                          RowHeight="32"
                          SelectionMode="Single"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3D5A8C"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#D8E2F5"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2A3A5C"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#D8E2F5"/>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Padding" Value="4,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Background" Value="#2B3A5C"/>
                            <Setter Property="Foreground" Value="#D8E2F5"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="4,3"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="CaretBrush" Value="#7EB3F7"/>
                        </Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Background" Value="#2B3A5C"/>
                            <Setter Property="Foreground" Value="#D8E2F5"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <!-- 键（只读） -->
                        <DataGridTextColumn Header="键" Binding="{Binding Key}" IsReadOnly="True" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#7A8FC0"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- 省份ID（只读） -->
                        <DataGridTextColumn Header="省份ID" Binding="{Binding ProvinceId}" IsReadOnly="True" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#5EC98C"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- 英文名 -->
                        <DataGridTextColumn Header="英文名" Binding="{Binding EnglishName, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <!-- 中文名 -->
                        <DataGridTextColumn Header="中文名" Binding="{Binding ChineseName, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <!-- 建筑等级 -->
                        <DataGridComboBoxColumn Header="建筑等级" SelectedItemBinding="{Binding BuildingLevel, UpdateSourceTrigger=PropertyChanged}"
                                               Width="110">
                            <DataGridComboBoxColumn.ItemsSource>
                                <x:Array Type="system:String" xmlns:system="clr-namespace:System;assembly=mscorlib">
                                    <system:String>castle_01</system:String>
                                    <system:String>castle_02</system:String>
                                    <system:String>castle_03</system:String>
                                    <system:String>castle_04</system:String>
                                    <system:String>castle_05</system:String>
                                </x:Array>
                            </DataGridComboBoxColumn.ItemsSource>
                        </DataGridComboBoxColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 按钮行 -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtStatus" Grid.Column="0" Foreground="#7A8FC0" FontSize="11"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="2" Content="取消" Click="Cancel_Click"
                    Style="{StaticResource DlgBtn}" Background="#4A3A5C" Foreground="#D8E2F5"/>
            <Button Grid.Column="4" Content="⚙ 生成文件" Click="Generate_Click"
                    Style="{StaticResource DlgBtn}" Background="#3A6FA5" Foreground="White"/>
        </Grid>
    </Grid>
</Window>
