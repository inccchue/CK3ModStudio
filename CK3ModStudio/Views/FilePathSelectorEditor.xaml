<UserControl x:Class="WpfPrismFrameworkTemplate.Views.FilePathSelectorEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfPrismFrameworkTemplate.Views"
             mc:Ignorable="d" 
             x:Name="_uc">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="1" 
                 Margin="5"
                 Text="{Binding Value, ElementName=_uc}" 
                 IsReadOnly="True"
                 VerticalContentAlignment="Center" Style="{StaticResource TextBoxExtend}"/>
        <Button Grid.Column="0" 
                Content="..." 
                Width="25" 
                Margin="5" 
                Click="BrowseButton_Click" />
    </Grid>
</UserControl>
