<UserControl x:Class="WpfPrismFrameworkTemplate.Views.CountyTimelineUserControl"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:ctrlz="clr-namespace:ControlzEx.Behaviors;assembly=ControlzEx"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:viewmodels="clr-namespace:WpfPrismFrameworkTemplate.ViewModels"
    xmlns:cv="clr-namespace:WpfPrismFrameworkTemplate.Converter"
    xmlns:model="clr-namespace:WpfPrismFrameworkTemplate.Model" 
    xmlns:helper="clr-namespace:WpfPrismFrameworkTemplate.Helper"
    xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    xmlns:ui="http://schemas.modernwpf.com/2019"
xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"          
             prism:ViewModelLocator.AutoWireViewModel="True" >
    <UserControl.Resources>
        <cv:LiegeEntriesToVisibilityConverter x:Key="LiegeEntriesToVisibilityConverter"/>

        <Style x:Key="TimelineRectStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="30" />
            <Setter Property="Stroke" Value="Black" />
            <Setter Property="StrokeThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="3" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <i:Interaction.Triggers>
    </i:Interaction.Triggers>
    <Grid Background="White">
        <Grid.RowDefinitions>
            
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>
        <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Background="DarkRed">
            <Button Style="{StaticResource ButtonWarning}" Background="#0000" BorderThickness="0" Foreground="Black"
hc:BorderElement.CornerRadius="15"  Command="{Binding SaveCmd}"
>
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/savefile.png" />
                    </StackPanel>
                </Button.Content>
            </Button>
            <TextBlock Text="선택된 가문" Foreground="White" FontWeight="Heavy" VerticalAlignment="Center" Margin="5"/>
            <hc:ComboBox  Width="100" 
                     SelectedItem="{Binding SelectFamily}"
                     VerticalAlignment='Center'
                     ItemsSource="{Binding FamilyList}" 
                     DisplayMemberPath="FamilyName" 
                     IsTextSearchEnabled="False"
                     Style="{StaticResource ComboBoxExtend.Small}"
                          >
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding SelectChangeCmd}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </hc:ComboBox>
            <Button Style="{StaticResource ButtonWarning}" Background="#0000" BorderThickness="0" Foreground="Black"
hc:BorderElement.CornerRadius="15"  Command="{Binding FitCmd}"
                ToolTip="선택된 가문을 선택된 영지의 타임라인에 맞추기">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/tiehe.png" />
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button Style="{StaticResource ButtonWarning}" Background="#0000" BorderThickness="0" Foreground="Black"
hc:BorderElement.CornerRadius="15"  Command="{Binding RevokeCmd}"
                 ToolTip="방금 맞춘 작업 취소">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/chexiao3.png" Height="15"/>
                    </StackPanel>
                </Button.Content>
            </Button>
        </WrapPanel>
        <ScrollViewer Grid.Row="0" Grid.Column="0" Style="{StaticResource ScrollViewerNativeBaseStyle}">
            <StackPanel >
                <StackPanel >
                    <ui:AutoSuggestBox x:Name="CountyAutoSuggestBox"
            PlaceholderText="영지 검색..." VerticalAlignment="Center" Margin="5"
            Text="{Binding SelectCounty, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
            ItemsSource="{Binding Suggestions}"
                                    TextChanged="AutoSuggestBox_TextChanged"
    QuerySubmitted="AutoSuggestBox_QuerySubmitted"
    SuggestionChosen="AutoSuggestBox_SuggestionChosen">

                        <!-- 사용자 정의 프로젝트 템플릿 -->
                        <ui:AutoSuggestBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Column="0" Grid.Row="0"
Text="{Binding Name}" 
FontWeight="Bold" />

                                    </Grid>
                                    <Border Grid.Row="1" 
                    BorderThickness="0,0,0,1" 
                    BorderBrush="#20000000" 
                    Margin="0" />
                                </Grid>


                            </DataTemplate>
                        </ui:AutoSuggestBox.ItemTemplate>
                    </ui:AutoSuggestBox>
                </StackPanel>
                <ListView Grid.Row="0" Grid.Column="0" ItemsSource="{Binding Counties}" SelectedItem="{Binding SelectCounty}"
                    >
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <WrapPanel>
                                <Image Source="/Images/queshao.png"  Height="15" Margin="5" Visibility="{Binding LiegeEntries,Converter={StaticResource LiegeEntriesToVisibilityConverter }}"
ToolTip="작위 정의 누락"/>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="Black"
Style="{StaticResource TextBlockDefaultInfo}"/>
                                
                            </WrapPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>

        <TabControl Grid.Column="2" Grid.Row="0" Style="{StaticResource TabControlInLine}">
            <TabItem Header="영지 보유자 타임라인">
                <ScrollViewer Grid.Column="2" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 
              Style="{StaticResource ScrollViewerNativeBaseStyle}">
                    <ItemsControl ItemsSource="{Binding TimelineEntries}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 날짜 범위 -->
                                    <TextBlock Grid.Column="0" Text="{Binding StartDate}" 
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                    <!-- 연결선과 점 -->
                                    <Grid Grid.Column="1">
                                        <Line X1="15" Y1="0" X2="15" Y2="40" Stroke="Gray" StrokeThickness="2"/>
                                        <Ellipse Width="14" Height="14" Fill="{Binding Background}" Stroke="Black" 
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Button Grid.Column="2" hc:IconElement.Geometry="{StaticResource AddGeometry}" hc:IconElement.Height="10" hc:IconElement.Width="10" Background="Green" Foreground="White" Style="{StaticResource ButtonIconCircular.Small}"
Command="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}, Path=DataContext.AddCmd}"
                            CommandParameter="{Binding}"/>
                                    <Button Grid.Column="3" hc:IconElement.Geometry="{StaticResource SubGeometry}" hc:IconElement.Height="10" hc:IconElement.Width="10" Background="Red" Foreground="White" Style="{StaticResource ButtonIconCircular.Small}"
                            Command="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}, Path=DataContext.DelCmd}"
                            CommandParameter="{Binding}"/>
                                    <!-- 보유자 정보 -->
                                    <Border Grid.Column="4" Background="{Binding Background}" CornerRadius="5" 
                            Padding="10,5" MinHeight="30">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="{Binding Holder}" FontWeight="Bold"/>
                                            <WrapPanel Grid.Row="1">
                                                <TextBlock  Text="{Binding StartDate, StringFormat='부터 {0}'}"/>
                                                <TextBlock  Text="{Binding EndDate, StringFormat='까지 {0}'}"/>
                                            </WrapPanel>

                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="영지 작위 타임라인">
                <ScrollViewer Grid.Column="2" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 
              Style="{StaticResource ScrollViewerNativeBaseStyle}">
                    
                    <StackPanel >
                        <DataGrid ItemsSource="{Binding SelectCounty.LiegeEntries}" HorizontalAlignment="Stretch"  CanUserAddRows="True" AutoGenerateColumns="False" 
                                  Style="{StaticResource DataGrid.Small}" >
                            <DataGrid.Columns>
                                <DataGridTemplateColumn CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ToggleButton hc:IconElement.Geometry="{StaticResource CloseGeometry}" Style="{StaticResource ToggleButtonIconTransparent}" Foreground="Black" VerticalAlignment="Center"
                                                Command="{Binding DataContext.DeleteItemCmd, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="100" Header="시작 시간" Binding="{Binding StartDate}" />
                                <DataGridTextColumn Header="상위 작위" Binding="{Binding Liege}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <!--<ListView ItemsSource="{Binding SelectCounty.LiegeEntries}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    >
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <UniformGrid Rows="1" Columns="2" >
                                        <TextBlock Text="{Binding StartDate}" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Liege}" FontWeight="Bold" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </UniformGrid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>-->
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        
    </Grid>
</UserControl>
