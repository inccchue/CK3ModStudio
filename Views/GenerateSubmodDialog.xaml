<Window x:Class="WpfPrismFrameworkTemplate.Views.GenerateSubmodDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cv="clr-namespace:WpfPrismFrameworkTemplate.Converter"
        Title="하위 생성mod파일"
        Width="800" Height="700"
        MinWidth="700" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="#1E2740">
    <Window.Resources>
        <cv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="DlgBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7A8FC0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="DlgInput" TargetType="TextBox">
            <Setter Property="Background" Value="#2B3452"/>
            <Setter Property="Foreground" Value="#D8E2F5"/>
            <Setter Property="BorderBrush" Value="#48577A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="CaretBrush" Value="#7EB3F7"/>
        </Style>

        <Style x:Key="ReadonlyField" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D8E2F5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#1A2236"/>
            <Setter Property="Padding" Value="7,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 제목 -->
            <RowDefinition Height="Auto"/>
            <!-- 경로 -->
            <RowDefinition Height="Auto"/>
            <!-- 백작령 정보 -->
            <RowDefinition Height="Auto"/>
            <!-- 설정 -->
            <RowDefinition Height="*"/>
            <!-- 남작령 표 -->
            <RowDefinition Height="Auto"/>
            <!-- 버튼 -->
        </Grid.RowDefinitions>

        <!-- 제목줄 -->
        <Border Grid.Row="0" Background="#2B3A5C" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚜" FontSize="22" Foreground="#7EB3F7" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="생성 AGOT 하위mod파일" FontSize="15" FontWeight="Bold" Foreground="#D8E2F5"/>
                    <TextBlock x:Name="TxtCountyKeyHeader" FontSize="11" Foreground="#7A8FC0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 경로 설정 -->
        <Border Grid.Row="1" Background="#222B44" CornerRadius="7" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="하위mod경로" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource DlgInput}"
                                 Text="{Binding SubmodPath, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Content="…" Click="BrowseSubmod_Click"
                                Style="{StaticResource DlgBtn}" Background="#364063" Foreground="#D8E2F5"
                                Padding="10,5" FontSize="13" ToolTip="선택 하위mod폴더"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="AGOT주mod경로" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource DlgInput}"
                                 Text="{Binding AgotModPath, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Content="…" Click="BrowseAgot_Click"
                                Style="{StaticResource DlgBtn}" Background="#364063" Foreground="#D8E2F5"
                                Padding="10,5" FontSize="13" ToolTip="선택AGOT주mod폴더"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 백작령 정보（읽기 전용） -->
        <Border Grid.Row="2" Background="#222B44" CornerRadius="7" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="백작령" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="TxtCountyKey" Style="{StaticResource ReadonlyField}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="공작령" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="TxtDuchyKey" Style="{StaticResource ReadonlyField}"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="왕국" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="TxtKingdomKey" Style="{StaticResource ReadonlyField}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 주 설정 -->
        <Border Grid.Row="3" Background="#222B44" CornerRadius="7" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="영문 이름 (백작령)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource DlgInput}"
                             Text="{Binding EnglishName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="이름 (백작령)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource DlgInput}"
                             Text="{Binding ChineseName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="개발도" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource DlgInput}"
                             Text="{Binding DevelopmentLevel, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBlock Text="문화 (culture)" Style="{StaticResource FieldLabel}" Margin="0"/>
                        <TextBlock Text=" ⟳" Foreground="#7EB3F7" FontSize="11" VerticalAlignment="Center"
                                   Visibility="{Binding IsLoadingLists, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                    <ComboBox IsEditable="True"
                              Text="{Binding Culture, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding Cultures}"
                              Background="#2B3452" Foreground="#D8E2F5"
                              BorderBrush="#48577A" BorderThickness="1"
                              FontSize="12" FocusVisualStyle="{x:Null}"/>
                </StackPanel>
                <StackPanel Grid.Column="8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBlock Text="종교 (religion)" Style="{StaticResource FieldLabel}" Margin="0"/>
                        <TextBlock Text=" ⟳" Foreground="#7EB3F7" FontSize="11" VerticalAlignment="Center"
                                   Visibility="{Binding IsLoadingLists, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                    <ComboBox IsEditable="True"
                              Text="{Binding Religion, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding Religions}"
                              Background="#2B3452" Foreground="#D8E2F5"
                              BorderBrush="#48577A" BorderThickness="1"
                              FontSize="12" FocusVisualStyle="{x:Null}"/>
                </StackPanel>
                <StackPanel Grid.Column="10">
                    <TextBlock Text="히스토리 파일 지역명" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource DlgInput}"
                             Text="{Binding TitleHistoryRegion, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="기록 xsy_titles_{region}.txt，예 the_stormlands"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 남작령 표 -->
        <Border Grid.Row="4" Background="#222B44" CornerRadius="7" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 참조 백작령 행 -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="참조 백작령 키（통치자 역사 복사）" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource DlgInput}"
                                 Text="{Binding ReferenceCountyKey, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="같은 공작령 하위의 참조 백작령，예 c_storms_end；비워두면 통치자 역사 생략"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="안내" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="남작령 영문명/영문 이름과 건물 등급은 아래 표에 입력하세요" Foreground="#7A8FC0" FontSize="11" VerticalAlignment="Center" Padding="7,5"/>
                    </StackPanel>
                </Grid>

                <!-- 표 머리글 -->
                <Grid Grid.Row="1" Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="남작령 키" Style="{StaticResource FieldLabel}" Padding="4,0"/>
                    <TextBlock Grid.Column="1" Text="지역ID" Style="{StaticResource FieldLabel}" Padding="4,0"/>
                    <TextBlock Grid.Column="2" Text="영문 이름" Style="{StaticResource FieldLabel}" Padding="4,0"/>
                    <TextBlock Grid.Column="3" Text="이름" Style="{StaticResource FieldLabel}" Padding="4,0"/>
                    <TextBlock Grid.Column="4" Text="건물 등급" Style="{StaticResource FieldLabel}" Padding="4,0"/>
                </Grid>

                <!-- 남작령 목록 -->
                <DataGrid Grid.Row="2"
                          x:Name="BaroniesGrid"
                          ItemsSource="{Binding Baronies}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="None"
                          GridLinesVisibility="None"
                          Background="#1E2740"
                          RowBackground="#222B44"
                          AlternatingRowBackground="#263050"
                          Foreground="#D8E2F5"
                          BorderThickness="0"
                          RowHeight="32"
                          SelectionMode="Single"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3D5A8C"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#D8E2F5"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2A3A5C"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#D8E2F5"/>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Padding" Value="4,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Background" Value="#2B3A5C"/>
                            <Setter Property="Foreground" Value="#D8E2F5"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="4,3"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="CaretBrush" Value="#7EB3F7"/>
                        </Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Background" Value="#2B3A5C"/>
                            <Setter Property="Foreground" Value="#D8E2F5"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <!-- 키（읽기 전용） -->
                        <DataGridTextColumn Header="키" Binding="{Binding Key}" IsReadOnly="True" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#7A8FC0"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- 지역ID（읽기 전용） -->
                        <DataGridTextColumn Header="지역ID" Binding="{Binding ProvinceId}" IsReadOnly="True" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#5EC98C"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- 영문 이름 -->
                        <DataGridTextColumn Header="영문 이름" Binding="{Binding EnglishName, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <!-- 이름 -->
                        <DataGridTextColumn Header="이름" Binding="{Binding ChineseName, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <!-- 건물 등급 -->
                        <DataGridComboBoxColumn Header="건물 등급" SelectedItemBinding="{Binding BuildingLevel, UpdateSourceTrigger=PropertyChanged}"
                                               Width="110">
                            <DataGridComboBoxColumn.ItemsSource>
                                <x:Array Type="system:String" xmlns:system="clr-namespace:System;assembly=mscorlib">
                                    <system:String>castle_01</system:String>
                                    <system:String>castle_02</system:String>
                                    <system:String>castle_03</system:String>
                                    <system:String>castle_04</system:String>
                                    <system:String>castle_05</system:String>
                                </x:Array>
                            </DataGridComboBoxColumn.ItemsSource>
                        </DataGridComboBoxColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 버튼 행 -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtStatus" Grid.Column="0" Foreground="#7A8FC0" FontSize="11"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="2" Content="취소" Click="Cancel_Click"
                    Style="{StaticResource DlgBtn}" Background="#4A3A5C" Foreground="#D8E2F5"/>
            <Button Grid.Column="4" Content="⚙ 파일 생성" Click="Generate_Click"
                    Style="{StaticResource DlgBtn}" Background="#3A6FA5" Foreground="White"/>
        </Grid>
    </Grid>
</Window>
