<UserControl x:Class="WpfPrismFrameworkTemplate.Views.StatisticsUserControl"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:cv="clr-namespace:WpfPrismFrameworkTemplate.Converter"
    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
    prism:ViewModelLocator.AutoWireViewModel="True" >
    <UserControl.Resources>
        <cv:StatisTypeAndHeaderToVisibilityConverter x:Key="StatisTypeAndHeaderToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <hc:SideMenu BorderThickness="1">
            <hc:SideMenuItem Header="가문 통계 데이터" FontSize="16" FontWeight="Heavy">
                <hc:SideMenuItem.Icon>
                    <Image Source="/Images/family.png" Width="24" Height="24"/>
                </hc:SideMenuItem.Icon>
                <hc:SideMenuItem Header="가문별 인원수" Command="{Binding SelectCmd}" CommandParameter="{Binding Header,RelativeSource={RelativeSource Self}}"/>
                <hc:SideMenuItem Header="가문별 평균 수명" Command="{Binding SelectCmd}" CommandParameter="{Binding Header,RelativeSource={RelativeSource Self}}"/>
            </hc:SideMenuItem>
            <hc:SideMenuItem Header="기타 통계 데이터" FontSize="16" FontWeight="Heavy">
                <hc:SideMenuItem.Icon>
                    <Image Source="/Images/misc.png" Width="24" Height="24"/>
                </hc:SideMenuItem.Icon>
                <hc:SideMenuItem Header="문화별 인원수" Command="{Binding SelectCmd}" CommandParameter="{Binding Header,RelativeSource={RelativeSource Self}}"/>
                <hc:SideMenuItem Header="종교별 인원수" Command="{Binding SelectCmd}" CommandParameter="{Binding Header,RelativeSource={RelativeSource Self}}"/>
                <hc:SideMenuItem Header="성별 비율" Command="{Binding SelectCmd}" CommandParameter="{Binding Header,RelativeSource={RelativeSource Self}}"/>
            </hc:SideMenuItem>
        </hc:SideMenu>

        <!-- 가문별 인원수 -->
        <Grid Grid.Column="1" x:Name="가문별 인원수" Margin="10">
            <Grid.Visibility>
                <MultiBinding Converter="{StaticResource StatisTypeAndHeaderToVisibilityConverter}">
                    <Binding Path="SelectedStatisType" />
                    <Binding RelativeSource="{RelativeSource Self}" Path="Name" />
                </MultiBinding>
            </Grid.Visibility>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="가문별 인원수" HorizontalAlignment="Center" FontWeight="Heavy" VerticalAlignment="Center"/>
            <lvc:CartesianChart Grid.Row="1" Padding="5">
                <lvc:CartesianChart.Series>
                    <lvc:ColumnSeries Values="{Binding SeriesValues}" DataLabels="True"/>
                </lvc:CartesianChart.Series>
                <lvc:CartesianChart.AxisX>
                    <lvc:Axis Labels="{Binding XLabels}"
                              FontWeight="Heavy"
                              ShowLabels="True"
                              Foreground="Black"
                              FontSize="12"
                              LabelsRotation="-45">
                        <lvc:Axis.Separator>
                            <lvc:Separator Step="1" StrokeThickness="0"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisX>
                <lvc:CartesianChart.AxisY>
                    <lvc:Axis Title="인원수" MinValue="0">
                        <lvc:Axis.Separator>
                            <lvc:Separator Step="1"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisY>
            </lvc:CartesianChart>
        </Grid>

        <!-- 가문별 평균 수명 -->
        <Grid Grid.Column="1" x:Name="가문별 평균 수명" Margin="10">
            <Grid.Visibility>
                <MultiBinding Converter="{StaticResource StatisTypeAndHeaderToVisibilityConverter}">
                    <Binding Path="SelectedStatisType" />
                    <Binding RelativeSource="{RelativeSource Self}" Path="Name" />
                </MultiBinding>
            </Grid.Visibility>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="가문별 평균 수명（출생 기록이 완전한 인물만 집계/사망 기록이 있는 사람）" HorizontalAlignment="Center" FontWeight="Heavy" VerticalAlignment="Center"/>
            <lvc:CartesianChart Grid.Row="1" Padding="5">
                <lvc:CartesianChart.Series>
                    <lvc:ColumnSeries Values="{Binding AvgAgeValues}" DataLabels="True" Title="평균 수명（세）"/>
                </lvc:CartesianChart.Series>
                <lvc:CartesianChart.AxisX>
                    <lvc:Axis Labels="{Binding AvgAgeLabels}"
                              FontWeight="Heavy"
                              ShowLabels="True"
                              Foreground="Black"
                              FontSize="12"
                              LabelsRotation="-45">
                        <lvc:Axis.Separator>
                            <lvc:Separator Step="1" StrokeThickness="0"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisX>
                <lvc:CartesianChart.AxisY>
                    <lvc:Axis Title="세" MinValue="0"/>
                </lvc:CartesianChart.AxisY>
            </lvc:CartesianChart>
        </Grid>

        <!-- 문화별 인원수 -->
        <Grid Grid.Column="1" x:Name="문화별 인원수" Margin="10">
            <Grid.Visibility>
                <MultiBinding Converter="{StaticResource StatisTypeAndHeaderToVisibilityConverter}">
                    <Binding Path="SelectedStatisType" />
                    <Binding RelativeSource="{RelativeSource Self}" Path="Name" />
                </MultiBinding>
            </Grid.Visibility>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="문화별 인원수" HorizontalAlignment="Center" FontWeight="Heavy" VerticalAlignment="Center"/>
            <lvc:PieChart Grid.Row="1" LegendLocation="Bottom" Series="{Binding PieSeriesCollection}" DataTooltip="{x:Null}"/>
        </Grid>

        <!-- 종교별 인원수 -->
        <Grid Grid.Column="1" x:Name="종교별 인원수" Margin="10">
            <Grid.Visibility>
                <MultiBinding Converter="{StaticResource StatisTypeAndHeaderToVisibilityConverter}">
                    <Binding Path="SelectedStatisType" />
                    <Binding RelativeSource="{RelativeSource Self}" Path="Name" />
                </MultiBinding>
            </Grid.Visibility>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="종교별 인원수" HorizontalAlignment="Center" FontWeight="Heavy" VerticalAlignment="Center"/>
            <lvc:PieChart Grid.Row="1" LegendLocation="Bottom" Series="{Binding ReligionPieSeriesCollection}" DataTooltip="{x:Null}"/>
        </Grid>

        <!-- 성별 비율 -->
        <Grid Grid.Column="1" x:Name="성별 비율" Margin="10">
            <Grid.Visibility>
                <MultiBinding Converter="{StaticResource StatisTypeAndHeaderToVisibilityConverter}">
                    <Binding Path="SelectedStatisType" />
                    <Binding RelativeSource="{RelativeSource Self}" Path="Name" />
                </MultiBinding>
            </Grid.Visibility>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="성별 비율" HorizontalAlignment="Center" FontWeight="Heavy" VerticalAlignment="Center"/>
            <lvc:PieChart Grid.Row="1" LegendLocation="Bottom" Series="{Binding GenderPieSeriesCollection}" DataTooltip="{x:Null}"/>
        </Grid>

    </Grid>
</UserControl>
